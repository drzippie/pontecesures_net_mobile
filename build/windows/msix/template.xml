<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="pontecesures_net_mobile"
        Arguments=""
        InstallLocation="C:\Program Files\Pontecesures.net\Pontecesures.net">
    </Installer>
    <PackageInformation
        PackageName="Pontecesures.net"
        PackageDisplayName="Pontecesures.net"
        PublisherName="CN=Pontecesures.net"
        PublisherDisplayName="Pontecesures.net"
        Version="0.1.0.0"
        PackageDescription="Novas de Pontecesures">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="net.pontecesures.app"
                Description="Novas de Pontecesures"
                DisplayName="Pontecesures.net"
                ExecutableName="pontecesures_net_mobile"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Pontecesures.net</DisplayName>
            <PublisherDisplayName>Pontecesures.net</PublisherDisplayName>
            <Description>Novas de Pontecesures</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="pontecesures_net_mobile.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
